<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Accredited Institutions | IBAC</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #0b1f33;
      --secondary: #122c45;
      --gold: #c9a34e;
      --light-gold: #e4c77c;
      --white: #ffffff;
      --light: #f5f7fa;
      --gray: #6c757d;
      --border: #dfe3e8;
      --success: #1f7a4d;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--light);
      color: #222;
      line-height: 1.6;
    }

    /* HEADER */

    header {
      background: var(--primary);
      color: var(--white);
      padding: 20px 7%;
      border-bottom: 3px solid var(--gold);
    }

    .header-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      margin: auto;
    }

    .logo h1 {
      font-size: 24px;
      letter-spacing: 1px;
      margin-bottom: 3px;
    }

    .logo span {
      color: var(--light-gold);
      font-size: 12px;
      letter-spacing: 1px;
    }

    nav {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    nav a {
      color: var(--white);
      text-decoration: none;
      font-size: 14px;
      transition: 0.3s;
    }

    nav a:hover {
      color: var(--gold);
    }

    /* HERO */

    .hero {
      background:
        linear-gradient(rgba(11, 31, 51, 0.92),
        rgba(11, 31, 51, 0.92));
      color: white;
      text-align: center;
      padding: 85px 20px;
    }

    .hero h2 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .hero p {
      max-width: 800px;
      margin: auto;
      font-size: 18px;
      color: #e8edf2;
    }

    .gold-line {
      width: 80px;
      height: 3px;
      background: var(--gold);
      margin: 25px auto;
    }

    /* MAIN */

    .container {
      max-width: 1200px;
      margin: auto;
      padding: 70px 20px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 20px;
    }

    .section-title h2 {
      color: var(--primary);
      font-size: 32px;
    }

    .section-title p {
      color: var(--gray);
      max-width: 750px;
      margin: 15px auto;
    }

    /* NOTICE */

    .notice {
      background: #fff8e5;
      border-left: 5px solid var(--gold);
      padding: 20px;
      margin: 40px 0;
      border-radius: 5px;
    }

    .notice strong {
      color: var(--primary);
    }

    /* SEARCH */

    .search-box {
      background: white;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      margin-bottom: 40px;
    }

    .search-box h3 {
      color: var(--primary);
      margin-bottom: 15px;
    }

    .search-box input {
      width: 100%;
      padding: 15px;
      border: 1px solid var(--border);
      border-radius: 5px;
      font-size: 15px;
    }

    /* REGISTER */

    .register {
      background: white;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .register-header {
      background: var(--primary);
      color: white;
      padding: 20px 25px;
    }

    .register-header h3 {
      font-size: 22px;
    }

    .register-header p {
      color: #d9e2ea;
      font-size: 14px;
      margin-top: 5px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      background: #eef1f4;
      color: var(--primary);
      text-align: left;
      padding: 15px;
      font-size: 14px;
    }

    td {
      padding: 18px 15px;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
    }

    tr:hover {
      background: #fafafa;
    }

    .institution-name {
      font-weight: bold;
      color: var(--primary);
    }

    .status {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: bold;
      background: #e6f5ec;
      color: var(--success);
    }

    .verify-number {
      color: var(--primary);
      font-weight: bold;
      font-size: 13px;
    }

    /* EMPTY STATE */

    .empty-state {
      text-align: center;
      padding: 70px 20px;
    }

    .empty-state h3 {
      color: var(--primary);
      font-size: 26px;
      margin-bottom: 15px;
    }

    .empty-state p {
      color: var(--gray);
      max-width: 700px;
      margin: auto;
    }

    /* INFORMATION BOX */

    .information {
      margin-top: 60px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .info-card {
      background: white;
      padding: 30px;
      border-radius: 8px;
      border-top: 4px solid var(--gold);
      box-shadow: 0 5px 20px rgba(0,0,0,0.07);
    }

    .info-card h3 {
      color: var(--primary);
      margin-bottom: 12px;
    }

    .info-card p {
      color: var(--gray);
      font-size: 14px;
    }

    /* CTA */

    .cta {
      margin-top: 70px;
      background: var(--primary);
      color: white;
      padding: 55px 30px;
      text-align: center;
      border-radius: 8px;
    }

    .cta h2 {
      margin-bottom: 15px;
    }

    .cta p {
      max-width: 700px;
      margin: 0 auto 25px;
      color: #dce5ed;
    }

    .button {
      display: inline-block;
      background: var(--gold);
      color: var(--primary);
      text-decoration: none;
      padding: 13px 25px;
      font-weight: bold;
      border-radius: 4px;
      transition: 0.3s;
    }

    .button:hover {
      background: var(--light-gold);
    }

    /* FOOTER */

    footer {
      background: #071522;
      color: white;
      padding: 50px 7% 20px;
      margin-top: 70px;
    }

    .footer-content {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 40px;
    }

    footer h3 {
      margin-bottom: 15px;
      color: var(--gold);
    }

    footer p,
    footer a {
      color: #b9c4cf;
      font-size: 14px;
      text-decoration: none;
    }

    footer a:hover {
      color: white;
    }

    .copyright {
      border-top: 1px solid #1f3447;
      margin-top: 35px;
      padding-top: 20px;
      text-align: center;
      color: #8fa0b0;
      font-size: 13px;
    }

    /* RESPONSIVE */

    @media (max-width: 768px) {

      .header-container {
        flex-direction: column;
        gap: 20px;
        text-align: center;
      }

      nav {
        justify-content: center;
      }

      .hero h2 {
        font-size: 30px;
      }

      table,
      thead,
      tbody,
      th,
      td,
      tr {
        display: block;
      }

      thead {
        display: none;
      }

      tr {
        margin-bottom: 15px;
        border-bottom: 2px solid var(--border);
      }

      td {
        border: none;
        padding: 10px 15px;
      }

      td::before {
        font-weight: bold;
        color: var(--primary);
      }

      td:nth-of-type(1)::before {
        content: "Institution: ";
      }

      td:nth-of-type(2)::before {
        content: "Country: ";
      }

      td:nth-of-type(3)::before {
        content: "Status: ";
      }

      td:nth-of-type(4)::before {
        content: "Accreditation Number: ";
      }

      td:nth-of-type(5)::before {
        content: "Valid Until: ";
      }
    }

  </style>
</head>

<body>

<header>

  <div class="header-container">

    <div class="logo">
      <h1>IBAC</h1>
      <span>INDEPENDENT BIBLICAL ACCREDITATION COMMISSION</span>
    </div>

    <nav>
      <a href="index.html#about">About</a>
      <a href="index.html#accreditation">Accreditation</a>
      <a href="index.html#standards">Standards</a>
      <a href="index.html#verify">Verify</a>
      <a href="accredited-schools.html">Accredited Schools</a>
      <a href="index.html#apply">Apply</a>
      <a href="index.html#contact">Contact</a>
    </nav>

  </div>

</header>


<section class="hero">

  <h2>Accredited Institutions</h2>

  <div class="gold-line"></div>

  <p>
    The official public register of institutions whose accreditation
    has been formally granted by the Independent Biblical Accreditation
    Commission.
  </p>

</section>


<section class="container">

  <div class="section-title">

    <h2>Official IBAC Accreditation Register</h2>

    <p>
      This register provides public information regarding institutions
      that have successfully completed the applicable IBAC accreditation
      review process and received a formal accreditation decision.
    </p>

  </div>


  <div class="notice">

    <strong>Important Transparency Notice:</strong>

    Only institutions that have received an official accreditation
    decision from IBAC should be listed in this register. Applicant,
    candidate, pending, expired, withdrawn, or unverified institutions
    must not be represented as currently accredited.

  </div>


  <div class="search-box">

    <h3>Search the Accreditation Register</h3>

    <input
      type="text"
      id="schoolSearch"
      placeholder="Search by institution name, country, or accreditation number..."
      onkeyup="searchSchools()"
    >

  </div>


  <div class="register">

    <div class="register-header">

      <h3>Currently Accredited Institutions</h3>

      <p>
        Official records published by the Independent Biblical
        Accreditation Commission.
      </p>

    </div>


    <!--
    =====================================================
    ADD ACCREDITED INSTITUTIONS BELOW
    =====================================================

    EXAMPLE:

    <tr>
      <td>
        <div class="institution-name">
          Revelation School of Missions
        </div>
      </td>

      <td>Liberia</td>

      <td>
        <span class="status">
          Accredited
        </span>
      </td>

      <td>
        <span class="verify-number">
          IBAC-2026-001
        </span>
      </td>

      <td>December 2031</td>
    </tr>

    Only publish genuine and formally approved accreditation records.
    =====================================================
    -->


    <table id="schoolsTable">

      <thead>

        <tr>
          <th>Institution</th>
          <th>Country</th>
          <th>Status</th>
          <th>Accreditation Number</th>
          <th>Valid Until</th>
        </tr>

      </thead>


      <tbody id="schoolsBody">

        <!--
        ADD YOUR OFFICIALLY ACCREDITED SCHOOLS HERE
        -->


        <!-- EMPTY REGISTER MESSAGE -->

        <tr id="emptyRow">

          <td colspan="5">

            <div class="empty-state">

              <h3>No Institutions Listed Yet</h3>

              <p>
                The official IBAC accreditation register currently
                contains no published accreditation records.
              </p>

              <br>

              <p>
                Institutions will appear in this register only after
                completing the required review process and receiving
                a formal accreditation decision.
              </p>

            </div>

          </td>

        </tr>

      </tbody>

    </table>

  </div>


  <div class="information">

    <div class="info-card">

      <h3>Verify Accreditation</h3>

      <p>
        Each officially accredited institution may be assigned a unique
        IBAC accreditation number for public verification and institutional
        identification.
      </p>

    </div>


    <div class="info-card">

      <h3>Current Status</h3>

      <p>
        Accreditation status is subject to continuing compliance,
        periodic review, institutional reporting, and quality assurance
        requirements.
      </p>

    </div>


    <div class="info-card">

      <h3>Public Transparency</h3>

      <p>
        IBAC maintains a public register to promote transparency and
        allow students, churches, institutions, and other stakeholders
        to verify accreditation claims.
      </p>

    </div>


  </div>


  <div class="cta">

    <h2>Is Your Institution Accredited?</h2>

    <p>
      Institutions interested in beginning the IBAC accreditation
      process may submit an institutional eligibility inquiry.
    </p>

    <a href="index.html#apply" class="button">
      Apply for Accreditation
    </a>

  </div>

</section>


<footer>

  <div class="footer-content">

    <div>

      <h3>IBAC</h3>

      <p>
        Independent accreditation for institutions committed to quality
        biblical and theological education.
      </p>

      <br>

      <p>
        Advancing excellence, integrity, accountability, and continuous
        improvement in biblical and theological education.
      </p>

    </div>


    <div>

      <h3>Explore</h3>

      <p><a href="index.html#about">About IBAC</a></p>
      <p><a href="index.html#accreditation">Accreditation Process</a></p>
      <p><a href="index.html#standards">Accreditation Standards</a></p>
      <p><a href="index.html#verify">Verify Accreditation</a></p>

    </div>


    <div>

      <h3>Resources</h3>

      <p><a href="accredited-schools.html">Accredited Institutions</a></p>
      <p><a href="index.html#apply">Apply for Accreditation</a></p>
      <p><a href="index.html#contact">Contact IBAC</a></p>

    </div>

  </div>


  <div class="copyright">

    © 2026 Independent Biblical Accreditation Commission (IBAC).
    All rights reserved.

  </div>

</footer>


<script>

function searchSchools() {

  const input =
    document.getElementById("schoolSearch");

  const filter =
    input.value.toLowerCase();

  const table =
    document.getElementById("schoolsTable");

  const rows =
    table.getElementsByTagName("tr");


  for (let i = 1; i < rows.length; i++) {

    const text =
      rows[i].textContent ||
      rows[i].innerText;


    if (
      text.toLowerCase().indexOf(filter) > -1
    ) {

      rows[i].style.display = "";

    } else {

      rows[i].style.display = "none";

    }

  }

}

</script>

</body>
</html>
